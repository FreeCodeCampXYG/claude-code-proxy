# Claude Code Proxy Configuration
#
# RECOMMENDED LOCATION: ~/.claude/proxy.env
#
# Alternative locations (checked in order):
#   1. ./.env (local project override)
#   2. ~/.claude/proxy.env (recommended)
#   3. ~/.claude-code-proxy

# ============================================================================
# Provider Configuration (Choose ONE)
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# OPTION 1: OpenRouter (Recommended - 200+ models)
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-your-openrouter-key
# For manual multi-key selection, replace OPENAI_API_KEY with:
# OPENAI_API_KEYS=sk-or-v1-first-key,sk-or-v1-second-key
# OPENAI_API_KEY_INDEX=1  # 1-based; change to 2 then restart to select key-2
# Optional provider override: openrouter, openai, ollama, newapi, or generic
# OPENAI_PROVIDER=openrouter

# Model routing examples for OpenRouter:
ANTHROPIC_DEFAULT_SONNET_MODEL=x-ai/grok-code-fast-1
ANTHROPIC_DEFAULT_HAIKU_MODEL=google/gemini-2.5-flash
# ANTHROPIC_DEFAULT_OPUS_MODEL=openai/gpt-5

# Optional: Better rate limits and dashboard tracking
# OPENROUTER_APP_NAME=Claude-Code-Proxy
# OPENROUTER_APP_URL=https://github.com/yourname/claude-code-proxy

# ─────────────────────────────────────────────────────────────────────────────
# OPTION 2: OpenAI Direct (o1/o3 reasoning models supported)
# ─────────────────────────────────────────────────────────────────────────────
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-proj-your-openai-key

# Model routing examples for OpenAI:
# ANTHROPIC_DEFAULT_SONNET_MODEL=gpt-4o
# ANTHROPIC_DEFAULT_HAIKU_MODEL=gpt-4o-mini
# ANTHROPIC_DEFAULT_OPUS_MODEL=o1-preview

# ─────────────────────────────────────────────────────────────────────────────
# OPTION 3: Ollama (Local - Free and Private)
# ─────────────────────────────────────────────────────────────────────────────
# OPENAI_BASE_URL=http://localhost:11434/v1
# No API key needed for Ollama! (localhost auth is skipped)

# Model routing examples for Ollama:
# ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-r1:70b
# ANTHROPIC_DEFAULT_HAIKU_MODEL=llama3.1:8b
# ANTHROPIC_DEFAULT_OPUS_MODEL=qwen2.5-coder:32b

# ============================================================================
# Optional - Model Routing Overrides
# ============================================================================

# Override pattern-based routing with specific models
# If not set, uses intelligent pattern matching

# Opus tier (default: gpt-5.6-sol)
# ANTHROPIC_DEFAULT_OPUS_MODEL=gpt-5.6-sol

# Sonnet tier (default: gpt-5.6-terra)
# ANTHROPIC_DEFAULT_SONNET_MODEL=gpt-5.6-terra

# Haiku tier (default: gpt-5.6-luna)
# ANTHROPIC_DEFAULT_HAIKU_MODEL=gpt-5.6-luna

# Router config file used by the diagnostics page route editor.
# Default: ~/.claude/proxy-router.json
# Windows: prefer forward slashes so dotenv does not interpret backslashes as escapes.
# ROUTER_CONFIG_PATH=D:/data/ClaudeWork/proxy-router.json
# Do not write a single-backslash Windows path inside double quotes. If quotes are
# required, escape every backslash: ROUTER_CONFIG_PATH="D:\\data\\ClaudeWork\\proxy-router.json"

# GPT/NewAPI tool-use compatibility: send parallel_tool_calls=false when tools are present.
# OPENAI_DISABLE_PARALLEL_TOOL_CALLS=true

# ============================================================================
# Optional - Security
# ============================================================================

# Client API key validation (optional)
# If set, clients must provide this exact key
# ANTHROPIC_API_KEY=your-validation-key

# ============================================================================
# Optional - Server Settings
# ============================================================================

# Server host (default: 0.0.0.0)
# HOST=0.0.0.0

# Server port (default: 8082)
# PORT=8082

# ============================================================================
# Optional - Advanced
# ============================================================================

# Passthrough mode - directly proxy to Anthropic API without conversion (default: false)
# Useful for debugging or when you want to use Anthropic API directly
# PASSTHROUGH_MODE=false

# Context-window error rewrite (default: enabled).
# 用于处理 NewAPI/兼容上游把“输入太长”包装成 HTTP 502 的情况。
# 开启后会改写为不可重试的客户端错误，避免 Claude Code 反复重试。
# CONTEXT_WINDOW_REWRITE_ENABLED=true
# CONTEXT_WINDOW_REWRITE_STATUS=413  # allowed: 400, 413, 422
# CONTEXT_WINDOW_ERROR_PATTERNS_MODE=append  # append = 内置关键词 + 自定义关键词；override = 只用自定义关键词
# CONTEXT_WINDOW_ERROR_PATTERNS=  # 多个关键词用英文逗号分隔

# Diagnostics storage (default: disabled). Set true/1/yes (case-insensitive).
# A running proxy must be stopped and restarted after changing this value.
# DIAGNOSTICS_ENABLED=false
# DIAGNOSTICS_DB_PATH=~/.claude/proxy-diagnostics.db
# DIAGNOSTICS_RETENTION=72h
# DIAGNOSTICS_BUSY_TIMEOUT=5s

# ==========================================================================
# Optional - Prompt Archive
# ==========================================================================

# Independent prompt archive for /prompts UI and request search/export.
# PROMPT_ARCHIVE_ENABLED=false
# PROMPT_ARCHIVE_DB_PATH=~/.claude/proxy-prompt-archive.db
# PROMPT_ARCHIVE_RETENTION=168h

# ==========================================================================
# Optional - Playground / UI expansion
# ==========================================================================

# These are reserved for future multi-provider and image workflow expansion.
# IMAGE_API_URL=https://api.example.com/v1
# IMAGE_API_KEY=your-image-api-key
# IMAGE_MODEL=image-model-id
# OCR_MODEL=ocr-model-id
# PPT_MODEL=ppt-model-id
